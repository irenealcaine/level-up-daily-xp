{
  "expo": {
    "name": "level-up-daily-xp",
    "slug": "level-up-daily-xp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "levelupdailyxp",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.irenealcaine.levelupdailyxp"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1a1a2e",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.irenealcaine.levelupdailyxp",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Permite que Level Up Daily marque tu posición en el mapa."
        }
      ],
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "7e424ee9-decb-4274-a142-293ce9078eb4"
      }
    }
  }
}
